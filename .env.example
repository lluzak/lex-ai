# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me

# Public URLs
LEXAI_BASE_URL=https://example.pl
# Public R2 custom domain serving original PDFs (optional)
LEXAI_FILES_BASE_URL=https://files.example.pl

# TLS behind Cloudflare: Origin CA certificate (SSL/TLS → Origin Server in the dashboard)
LEXAI_TLS_CERT=/certs/origin.pem
LEXAI_TLS_KEY=/certs/origin.key

# Cloudflare R2 (S3 API)
LEXAI_BLOB_DRIVER=s3
LEXAI_S3_ENDPOINT=<account_id>.r2.cloudflarestorage.com
LEXAI_S3_REGION=auto
LEXAI_S3_BUCKET=lexai-files
LEXAI_S3_ACCESS_KEY=
LEXAI_S3_SECRET_KEY=

# Ingestion
LEXAI_USER_AGENT=lex-ai/0.1 (+https://example.pl/kontakt)
LEXAI_SOURCE_RPS=3
LEXAI_WORKERS=8
LEXAI_DELTA_INTERVAL=24h
